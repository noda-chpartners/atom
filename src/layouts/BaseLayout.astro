---
import "../styles/global.scss";
import "lenis/dist/lenis.css";
import { site } from "../data/site";

interface Props {
	title?: string;
	description?: string;
}

const title = Astro.props.title ?? site.title;
const description = Astro.props.description ?? site.description;
const origin = Astro.site?.origin ?? "";
const pageUrl = origin ? new URL(Astro.url.pathname, origin).href : "";
const imageUrl = origin ? new URL("/ogp.jpg", origin).href : "/ogp.jpg";

const business: Record<string, unknown> = {
	"@type": ["LocalBusiness", "ProfessionalService"],
	name: site.name,
	alternateName: site.nameEn,
	description,
	telephone: "+81-80-2554-2115",
	image: imageUrl,
	address: {
		"@type": "PostalAddress",
		streetAddress: `${site.address.replace("東京都豊島区", "")} ${site.building}`,
		addressLocality: "豊島区",
		addressRegion: "東京都",
		addressCountry: "JP",
	},
	openingHoursSpecification: {
		"@type": "OpeningHoursSpecification",
		dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
		opens: "09:00",
		closes: "19:00",
	},
	areaServed: "JP",
	knowsLanguage: "ja",
	hasOfferCatalog: {
		"@type": "OfferCatalog",
		name: "事業内容",
		itemListElement: [
			"動画編集",
			"SNS運用",
			"営業・マーケティング",
			"コールセンター",
			"セールスプロモーション",
			"テレマーケティング",
		].map((name) => ({
			"@type": "Offer",
			itemOffered: {
				"@type": "Service",
				name,
			},
		})),
	},
};

if (pageUrl) {
	business["@id"] = `${pageUrl}#business`;
	business.url = pageUrl;
}

const jsonLd = {
	"@context": "https://schema.org",
	"@graph": [
		business,
		{
			"@type": "WebSite",
			...(pageUrl ? { "@id": `${pageUrl}#website`, url: pageUrl } : {}),
			name: site.name,
			inLanguage: "ja",
		},
		{
			"@type": "WebPage",
			name: title,
			description,
			inLanguage: "ja",
			...(pageUrl
				? {
						"@id": pageUrl,
						url: pageUrl,
						isPartOf: { "@id": `${pageUrl}#website` },
						about: { "@id": `${pageUrl}#business` },
					}
				: {}),
		},
	],
};
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1" />
		<meta name="author" content={site.name} />
		<meta name="theme-color" content="#1a1410" />
		{pageUrl && <link rel="canonical" href={pageUrl} />}
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="ja_JP" />
		<meta property="og:site_name" content={site.name} />
		{pageUrl && <meta property="og:url" content={pageUrl} />}
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={imageUrl} />
		<meta property="og:image:alt" content="株式会社ATOMのイメージ写真" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:type" content="image/jpeg" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageUrl} />
		<meta name="twitter:image:alt" content="株式会社ATOMのイメージ写真" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Zen+Kaku+Gothic+New:wght@400;500;700&family=Zen+Old+Mincho:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
		<script is:inline>
			if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
				document.documentElement.classList.add("motion");
			}
		</script>
		<style is:inline>
			html.motion [data-hero-item],
			html.motion [data-reveal] {
				opacity: 0;
			}
		</style>
		<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
	</head>
	<body>
		<a class="skip" href="#main">本文へスキップ</a>
		<slot />
		<script>
			import { initSite } from "../scripts/site";
			initSite();
		</script>
	</body>
</html>
