---
import Mark from "./Mark.astro";
import { site } from "../data/site";
---

<header class="header" data-header>
	<a class="header__logo" href="#top">
		<Mark />
		<span class="header__name">{site.nameEn}</span>
	</a>

	<nav class="nav" id="site-nav" data-nav aria-label="メイン">
		<a href="#services">事業内容</a>
		<a href="#jobs">お仕事紹介</a>
		<a href="#flow">応募の流れ</a>
		<a href="#company">会社概要</a>
		<a class="nav__tel" href={`tel:${site.tel}`}>
			<svg viewBox="0 0 24 24" aria-hidden="true">
				<path
					d="M7.2 3.8h2.1l1.2 3-1.5 1a12.4 12.4 0 0 0 5.2 5.2l1-1.5 3 1.2v2.1c0 .7-.6 1.4-1.3 1.4A14.2 14.2 0 0 1 5.8 5.1c0-.7.7-1.3 1.4-1.3Z"
					fill="none"
					stroke="currentColor"
					stroke-width="1.5"
					stroke-linejoin="round"></path>
			</svg>
			{site.telLabel}
		</a>
	</nav>

	<a class="header__tel" href={`tel:${site.tel}`}>
		<svg viewBox="0 0 24 24" aria-hidden="true">
			<path
				d="M7.2 3.8h2.1l1.2 3-1.5 1a12.4 12.4 0 0 0 5.2 5.2l1-1.5 3 1.2v2.1c0 .7-.6 1.4-1.3 1.4A14.2 14.2 0 0 1 5.8 5.1c0-.7.7-1.3 1.4-1.3Z"
				fill="none"
				stroke="currentColor"
				stroke-width="1.5"
				stroke-linejoin="round"></path>
		</svg>
		<span>{site.telLabel}</span>
	</a>

	<button
		class="header__toggle"
		type="button"
		data-menu-toggle
		aria-expanded="false"
		aria-controls="site-nav"
	>
		<span class="header__toggle-lines" aria-hidden="true"></span>
		<span class="sr-only">メニュー</span>
	</button>
</header>
